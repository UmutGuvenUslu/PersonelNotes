    {
        "id": "ba1b0eccfe2533b3",
        "type": "function",
        "z": "cb699f4ac2c58699",
        "name": "Not Normalizasyon",
        "func": "let n = msg.payload;\n\nif (n == null || n._id== null  || n.baslik == null ) {\n    msg.payload = { hata: \"Id ve başlık bilgileri zorunludur.\" };\n    return [null, msg];\n}\n\nlet note = {\n    _id:              n._id,\n    baslik:           n.baslik,\n    aciklama:         n.aciklama || \"\",\n    oncelik:          n.oncelik || 2,\n    silindiMi:        n.silindiMi === true,\n    guncellemeTarihi: n.guncellemeTarihi || Date.now()\n};\n\nmsg.not = note;\n\n\n\nmsg.payload = [ \n    { _id: note._id }, \n    note, \n    { upsert: true } \n    ];\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
