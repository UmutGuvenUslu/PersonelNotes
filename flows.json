    {
        "id": "9fcf7b2e0e414ca4",
        "type": "function",
        "z": "9d6976a8b5a31ec7",
        "name": "VeriKontrol",
        "func": "if (!msg.payload || !Array.isArray(msg.payload.records)) {\n    msg.statusCode = 400;\n    msg.payload = { status: \"error\", message: \"Geçersiz veri formatı\" };\n    return [null, msg];\n}\n\nmsg.payload = msg.payload.records.map(record => ({\n    query: { uuid: record.uuid }, \n    update: { $setOnInsert: record }, \n    options: { upsert: true }\n}));\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
