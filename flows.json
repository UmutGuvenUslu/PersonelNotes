    {
        "id": "045d79265c19726e",
        "type": "function",
        "z": "35b964c2a4e7b812",
        "name": "GüncellemeFiltre",
        "func": "const id = msg.req.params.id;\nconst n  = msg.payload || {};\n\nif (id == null) {\n    msg.payload = { hata: \"id zorunlu\" };\n    return [null, msg];\n}\n\nconst alanlar = {\n    baslik:           n.baslik,\n    aciklama:         n.aciklama || \"\",\n    oncelik:          n.oncelik || 2,\n    silindiMi:        n.silindiMi,\n    guncellemeTarihi: n.guncellemeTarihi\n};\n\n\nmsg.payload = [ \n    { _id: id }, \n    { $set: alanlar }, \n    { upsert: true } \n    ];\n\nreturn [msg, null];",
        "outputs": 2,
