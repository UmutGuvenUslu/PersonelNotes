    {
        "id": "f5a6d64bd28aeed0",
        "type": "function",
        "z": "59b03ea7b921cbf5",
        "name": "SenkronFiltre",
        "func": "let notlar = msg.payload\n\n\nif (notlar.length == 0) {\n    msg.payload = [];\n    return [null, msg];\n}\n\nif (notlar.some(n => n == null || n._id == null)) {\n    msg.payload = { hata: \"Notlarda ID eksik\" };\n    return [null, msg];\n}\n\nmsg.kaydedilenler = notlar.map(n => n._id);\n\nmsg.payload = [ notlar.map(n => {\n    if (n.silindiMi === true) {\n        return { deleteOne: { filter: { _id: n._id } } };\n    }\n    return {\n        replaceOne: {\n            filter: { _id: n._id },\n            replacement: {\n                _id:              n._id,\n                baslik:           n.baslik,\n                aciklama:         n.aciklama || \"\",\n                oncelik:          n.oncelik || 2,\n                silindiMi:        false,\n                guncellemeTarihi: n.guncellemeTarihi || Date.now()\n            },\n            upsert: true\n        }\n    };\n}) ];\n\nreturn [msg, null];",
        "outputs": 2,
